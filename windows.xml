        <action>
            evalXml('&lt;rect x="' + ((256/2)-(68/2)-20) + '" y="' + ((144/2)-18-20) + '" width="20" height="1" color="0e3801"/&gt;'); // Top
            evalXml('&lt;rect x="' + ((256/2)-(68/2)-20) + '" y="' + (((144/2)-18)+19-20) + '" width="20" height="1" color="0e3801"/&gt;'); // Bottom
            evalXml('&lt;rect x="' + ((256/2)-(68/2)-20) + '" y="' + (((144/2)-18)+1-20) + '" width="1" height="18" color="0e3801"/&gt;'); // Left
            evalXml('&lt;rect x="' + (((256/2)-(68/2))-1) + '" y="' + (((144/2)-18)+1-20) + '" width="1" height="18" color="0e3801"/&gt;'); // Right
        
            var i = 0;
            while (i &lt; 20) {
                evalXml('&lt;rect x="' + ((256/2)-(68/2) + i) + '" y="' + ((144/2)-18 + i) + '" width="1" height="1" color="0e3801"/&gt;');
