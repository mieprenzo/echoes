            evalXml('&lt;rect x="' + ((256/2)+(68/2)+17) + '" y="' + (((144/2))+20) + '" width="1" height="18" color="0e3801"/&gt;'); // Left
            evalXml('&lt;rect x="' + (((256/2)+(68/2))+17+19) + '" y="' + (((144/2))+20) + '" width="1" height="18" color="0e3801"/&gt;'); // Right
        
            var i = 0;
            while (i &lt; 20) {
                evalXml('&lt;rect x="' + ((256/2)+(68/2)-3 + i) + '" y="' + ((144/2) + i) + '" width="1" height="1" color="0e3801"/&gt;');
                i++;
            }
        </action>
        <tile id="'cdship'" x="256/2-(68/2)" y="144/2-(18/2)"/>
