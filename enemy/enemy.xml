  <enemy id="inf_carrier" tile="human_thrall" type="surface" vertical="true" passEnemies="true" friendlyFire="false" health="300" range="12" speed="1" defense="9" death_sfx="explosion">
    <attack type="projectile" animation="fire" range="12" damage="15" fireAll="true" minAngle="-10"  maxAngle="10" cooldown="150">
     <pre><sound id="infcarrier_attack"/></pre>
     <projectile tile="infg_shot.projectile" animation="infg_shot" glow="true" speed="3" offsetY="6" hit_sfx="bullet" color="730021" colorScale="3"  underwater="true"/>
     <projectile tile="infg_shot.projectile" animation="infg_shot" glow="true" speed="3" offsetY="12" delay="2" hit_sfx="bullet" color="730021" colorScale="3"  underwater="true"/>
     <projectile tile="infg_shot.projectile" animation="infg_shot" glow="true" speed="3" offsetY="9" delay="4" hit_sfx="bullet" color="730021" colorScale="3"  underwater="true"/>
     <projectile tile="infg_shot.projectile" animation="infg_shot" glow="true" speed="3" offsetY="3" delay="6" hit_sfx="bullet" color="730021" colorScale="3"  underwater="true"/>
     <projectile tile="infg_shot.projectile" animation="infg_shot" glow="true" speed="3" offsetY="6" delay="8" hit_sfx="bullet" color="730021" colorScale="3"  underwater="true"/>
    </attack>

    <cooldown id="spawn" seconds="4">
        <set id="recruitment" value="randInt(1,4)"/>
				<sound id="dragon_atk" /><play object="this" animation="spawn_begin" />
				<play object="this" animation="spawn_pre" /><set id="dx" value="this.getDX()" />

        <section if="recruitment == 1">
				<object id="human_thrall" x="dx == -1?this.tile_x+1:this.tile_right-1" y="this.tile_y">
					this.renderer.setTile(this.tile_x+dx, this.tile_y, this.renderer.speed);
				</object>
        </section>

        <section if="recruitment == 2">
				<object id="giantgrub" x="dx == -1?this.tile_x+1:this.tile_right-1" y="this.tile_y">
					this.renderer.setTile(this.tile_x+dx, this.tile_y, this.renderer.speed);
				</object>
        </section>

        <section if="recruitment == 3">
				<object id="paramedic" x="dx == -1?this.tile_x+1:this.tile_right-1" y="this.tile_y">
					this.renderer.setTile(this.tile_x+dx, this.tile_y, this.renderer.speed);
				</object>
        </section>

				<play object="this" animation="spawn_post" />
			<action>this.run();</action><stop />
		</cooldown>

    <onDeath>
    <set id="d_drop" value="randInt(1,4)"/>

    <section if="d_drop == 1">
     <object id="human_thrall" x="this.tile_x" y="this.tile_y"/>
    </section>
    <section if="d_drop == 2">
     <object id="human_thrall2" x="this.tile_x" y="this.tile_y"/>
    </section>
    <section if="d_drop == 3">
     <object id="giantgrub" x="this.tile_x" y="this.tile_y"/>
    </section>

   </onDeath>
   <onDeath>

    <set id="d_drop2" value="randInt(1,4)"/>

    <section if="d_drop2 == 1">
     <object id="human_thrall" x="this.tile_x+1" y="this.tile_y"/>
    </section>
    <section if="d_drop2 == 2">
     <object id="human_thrall2" x="this.tile_x+1" y="this.tile_y"/>
    </section>
    <section if="d_drop2 == 3">
     <object id="giantgrub" x="this.tile_x+1" y="this.tile_y"/>
    </section>

   </onDeath>
   <onDeath>

    <set id="d_drop3" value="randInt(1,4)"/>

    <section if="d_drop3 == 1">
     <object id="human_thrall" x="this.tile_x+2" y="this.tile_y"/>
    </section>
    <section if="d_drop3 == 2">
     <object id="human_thrall2" x="this.tile_x+2" y="this.tile_y"/>
    </section>
    <section if="d_drop3 == 3">
     <object id="giantgrub" x="this.tile_x+2" y="this.tile_y"/>
    </section>

   </onDeath>
   <onDeath>
    <object id="paramedic" x="this.tile_x+3" y="this.tile_y"/>
   </onDeath>
  </enemy> 



  <enemy id="paramedic" tile="paramedic" type="surface" vertical="true" passEnemies="true" health="60" range="20" speed="2" defense="12" death_sfx="cyborg_death">
    <target id="human_thrall"/>
    <target id="human_thrall2"/>
    <attack type="projectile" damage="1" range="12" animation="fire">
      <projectile tile="infg_shot.projectile" animation="infg_shot" damage="1" ignoreArmor="true" range="8" speed="4" fire_sfx="bandit_ranged_attack" color="048f4c" colorScale="3"  underwater="true">
        <onHit>
          <action>
            object.health = Math.min(object.info.xml.get("health"), Std.parseInt(object.health) + 10);
          </action>
        </onHit>
      </projectile>
    </attack>
  </enemy>

