  <tile id="human_thrall" sheet="humanthrall.png" x="0"/>
  <animation id="human_thrall.idle" x="27" count="2"/>
  <animation id="human_thrall.hit" x="0" count="4"/>
  <animation id="human_thrall.walk" x="4" count="11"/>
  <animation id="human_thrall.fire" x="14" count="9"/>
  <animation id="human_thrall.blade" x="23" count="6"/>
  <enemy id="human_thrall" tile="human_thrall" type="surface" vertical="true" passEnemies="true" health="50" range="20" speed="0" defense="9" death_sfx="cyborg_death">
    <attack type="projectile" damage="20" range="12" animation="fire">
     <projectile tile="exog_shot.projectile" animation="exog_shot" offsetY="-4" speed="5" fire_sfx="plasma_gun" color="730021" colorScale="3" underwater="true">
        <removed>
			<projectile tile="exog_shot.projectile" animation="exog_shot" damage="20" range="8" speed="3" spawnX="this.tile_x" spawnY="this.tile_y" spawner="this" relative="false" fire_sfx="camoflora_attack_hit" knockback="5" dx="player.getFacing()" dy="-0.5" color="730021" colorScale="3"  underwater="true">
        <light tile="light.small" color="730021" />
			</projectile>
      <projectile tile="exog_shot.projectile" animation="exog_shot" damage="20" range="8" speed="3" spawnX="this.tile_x" spawnY="this.tile_y" spawner="this" relative="false" fire_sfx="camoflora_attack_hit" knockback="5" dx="player.getFacing()" dy="0.5" color="730021" colorScale="3"  underwater="true">
				<light tile="light.small" color="730021" />
			</projectile>
        </removed>
     </projectile>
    </attack>
     <attack type="melee" damage="20" range="1" ignoreArmor="true" sfx="swords" animation="blade"/>
  
    <onDeath>
    <set id="recruitment" value="randInt(1,4)"/>

    <section if="recruitment == 1">
     <object id="human_thrall" x="this.tile_x+4" y="this.tile_y"/>
    </section>
    <section if="recruitment == 2">
     <object id="human_thrall2" x="this.tile_x+4" y="this.tile_y"/>
    </section>
    <section if="recruitment == 3">
     <object id="giantgrub" x="this.tile_x+4" y="this.tile_y"/>
    </section>

   </onDeath>
   <onDeath>

    <set id="recruitment2" value="randInt(1,4)"/>

    <section if="recruitment2 == 1">
     <object id="human_thrall" x="this.tile_x+2" y="this.tile_y"/>
    </section>
    <section if="recruitment2 == 2">
     <object id="human_thrall2" x="this.tile_x+2" y="this.tile_y"/>
    </section>
    <section if="recruitment2 == 3">
     <object id="giantgrub" x="this.tile_x+2" y="this.tile_y"/>
    </section>

   </onDeath>
   <onDeath>

    <set id="recruitment3" value="randInt(1,4)"/>

    <section if="recruitment3 == 1">
     <object id="human_thrall" x="this.tile_x+2" y="this.tile_y"/>
    </section>
    <section if="recruitment3 == 2">
     <object id="human_thrall2" x="this.tile_x" y="this.tile_y"/>
    </section>
    <section if="recruitment3 == 3">
     <object id="giantgrub" x="this.tile_x+1" y="this.tile_y"/>
    </section>

   </onDeath>
  </enemy>

  <enemy id="human_thrall2" extends="human_thrall" speed="2" type="golem" vertical="false">
    <cooldown id="spawn" seconds="400">
        <set id="recruitment4" value="randInt(1,4)"/>
				<sound id="dragon_atk" /><play object="this" animation="spawn_begin" />
				<play object="this" animation="spawn_pre" /><set id="dx" value="this.getDX()" />

        <section if="recruitment4 == 1">
				<object id="minotaur" x="dx == -1?this.tile_x+1:this.tile_right-1" y="this.tile_y">
					this.renderer.setTile(this.tile_x+dx, this.tile_y, this.renderer.speed);
				</object>
        </section>

        <section if="recruitment4 == 2">
				<object id="giantgrub" x="dx == -1?this.tile_x+1:this.tile_right-1" y="this.tile_y">
					this.renderer.setTile(this.tile_x+dx, this.tile_y, this.renderer.speed);
				</object>
        </section>

        <section if="recruitment4 == 3">
				<object id="fire_boar" x="dx == -1?this.tile_x+1:this.tile_right-1" y="this.tile_y">
					this.renderer.setTile(this.tile_x+dx, this.tile_y, this.renderer.speed);
				</object>
        </section>

				<play object="this" animation="spawn_post" />
			<action>this.run();</action><stop />
		</cooldown>
   <onDeath><stop/></onDeath>
   <lootSet><loot id="ship_parts" count="1"/></lootSet>
   <loot p="80"/>
	 <loot id="alloy" p="20"/>
  </enemy>

  <enemy id="paramedic" tile="boar" passEnemies="true" type="surface" health="50" range="10" speed="2" defense="9" death_sfx="cyborg_death">
    <attack type="projectile" tile="exog_shot.projectile" animation="exog_shot" offsetY="-4" speed="5" fire_sfx="plasma_gun" color="730021" colorScale="3" underwater="true">
      <projectile tile="exog_shot.projectile" animation="exog_shot" damage="20" range="8" speed="3" spawnX="this.tile_x" spawnY="this.tile_y" spawner="this" relative="false" fire_sfx="camoflora_attack_hit" color="730021" colorScale="3"  underwater="true">
        <onHit>
          <action>
            trace("object: " + object);
          </action>
        </onHit>
      </projectile>
    </attack>
  </enemy>

  <enemy id="paramedic" tile="boar" passEnemies="true" type="surface" health="50" range="20" speed="2" defense="9" death_sfx="cyborg_death">
    <flee id="human_thrall"/>
    <attack type="projectile" damage="1" tile="exog_shot.projectile" animation="exog_shot" speed="1" fire_sfx="plasma_gun" color="730021" colorScale="3">
      <projectile tile="exog_shot.projectile" animation="exog_shot" damage="1" range="8" speed="1" spawnX="this.tile_x" spawnY="this.tile_y" spawner="this" relative="false" fire_sfx="camoflora_attack_hit" color="730021" colorScale="3"  underwater="true">
        <onHit>
          <action>
            var maxHealth = object.info.xml.get("health");
            if(Std.parseInt(object.health) + 10 > Std.parseInt(maxHealth)) {
              object.health = maxHealth;
            } else {
              object.health = Std.parseInt(object.health) + 10;
            }
          </action>
        </onHit>
      </projectile>
    </attack>
  </enemy>
