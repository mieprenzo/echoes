<data>

  <object id="nanites" tile="emp" animation="emp" layer="top" fps="10" removeOnComplete="true" save="false" color="168c44" colorScale="5">
        
        <addedToArea><action>
          count = 0.0; hybrids = ["human_thrall", "human_thrall2", "paramedic"];
        </action></addedToArea>
        <onFrame>
            count += frames;
            if(count >= 15){
                if (hybrids.indexOf(o.info.id) != -1){
                o.heal(5, FLAG_IGNORE_DEFENSE|FLAG_HIDE_ATTACKER, spawner);
                }
            }
        </onFrame>
      </object>
</data>

