<?xml version="1.0" encoding="utf-8"?>
<data>
    <tilesheet id='bg' sheet='parallax.png' width='1071' height='96'>
        <image frame='0' x='0' y='0' width='1071' height='96' offsetY='26' />
    </tilesheet>
    <parallax id="echofern" mapBG="1b6a9d" mapBGHeight="80" waterLevel="0">
		<layer p="0" day="true"><rect color="544aab" x="0" y="0" width="256" height="144" /></layer>
		<layer p="0" day="false" storm="false" glow="true"><tile sheet="{mod:full_version}/space/night_bg.png" x="0" y="0" /></layer>

        <layer p="0" glow="true">
			<tile id="sun" animation="sun" fps="5" rise="5" set="20" dir="left" pathHeight="96" pathTop="-16" sun="true" />
		</layer>

        <layer p="0.9" py="0.9"><tile sheet="bg" x="0" /></layer>
	</parallax>

    <planet id="echofern.main" height="80" tile="planet10" offsetX="13" offsetY="15" name="system.planet.echofern.main">
        <orbit id="echofern.orbit" width="256" height="64" background="alien_hq.orbit" name="system.planet.echofern_orbit" type="none">
			<area id="echofern" x="0" />
            <init>
                <section if="getFlag('echoes_introduced') != 1">
                    <action>
                        setFlag('echoes_introduced', 1);
                    </action>
                    <scene id="echoes" show="intro"/>
                </section>
            </init>            
            <onLoad>
                <music id="orbit" seconds="1" />
                <radar tile="orbit.radar" animation="orbit.radar" padding="2" />
            </onLoad>
		</orbit>
    </planet>

    <section if="getSystem('echofern') == null">
        <system id="echofern" bgm="voyage" x="85" y="30" />
    </section>

    <system id="echofern" bgm="voyage" available="true" x="140" y="24">
    <planet id="echofern.main" tile="planet2" animation="planet.start.dwarf" offsetY="38"
        name="system.planet.echofern.main" />
    </system>

    <area id="echofern" planet="echofern.main" width="1071" height="96" background="echofern"
        looping="true">
        <tiles id="stone" start="0" end="1" />
        <tiles id="grass" y="0" />
        <tiles id="bedrock" y="95" />
        <init>
            <runAreaLoad />
        </init>
        <onLoad>
            <weather type="snow" height="0" />
        </onLoad>
    </area>
</data>